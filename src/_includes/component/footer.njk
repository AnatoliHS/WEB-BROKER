<style>
  .footer {
    background-color: var(--primary-color);
    color: var(--white);
    padding: 100px 0 40px;
    position: relative;
    overflow: hidden;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 60px;
    margin-bottom: 100px;
  }

  .footer-col h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-color);
    margin-bottom: 30px;
    font-weight: 700;
  }

  .footer-bio p {
    color: #cbd5e0;
    line-height: 1.6;
    margin-bottom: 30px;
    font-size: 1rem;
    max-width: 320px;
  }

  .footer-social {
    display: flex;
    gap: 15px;
  }

  .social-link {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: var(--white);
  }

  .social-link:hover {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
    transform: translateY(-3px);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .footer-links a {
    display: block;
    color: #cbd5e0;
    margin-bottom: 15px;
    font-size: 1rem;
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--white);
  }

  .footer-brand-row {
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 80px;
    margin-bottom: 60px;
  }

  .footer-brand-name {
    font-family: 'Teodor', var(--font-serif);
    font-size: clamp(4rem, 14vw, 12rem);
    color: var(--white);
    line-height: 0.9;
    letter-spacing: -0.02em;
    display: block;
    opacity: 0.9;
    white-space: nowrap;
  }

  .footer-tagline {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--accent-color);
    margin-top: 20px;
    font-weight: 500;
    display: block;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.85rem;
    color: #718096;
  }

  .disclaimer {
    font-size: 0.75rem;
    line-height: 1.6;
    margin-top: 40px;
    color: #4a5568;
    max-width: 100%;
    text-align: center;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-col h3 {
      margin-bottom: 20px;
    }

    .footer-bio p {
      margin-left: auto;
      margin-right: auto;
    }

    .footer-social {
      justify-content: center;
    }
    
    .footer-brand-name {
      font-size: 9.5vw;
    }

    .footer-brand-row {
      padding-top: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }

  .footer-policy-link {
    color: #718096;
    text-decoration: none;
    font-size: 0.85rem;
    position: relative;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-policy-link:hover {
    color: var(--white);
  }

  .footer-policy-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-color);
    transition: width 0.3s ease;
  }

  .footer-policy-link:hover::after {
    width: 100%;
  }
</style>

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Bio & Social -->
      <div class="footer-col footer-bio">
        <h3>Expert Advice</h3>
        <p>Providing professional, unbiased mortgage solutions tailored to your unique financial journey. Access to hundreds of products across Canada.</p>
        <div class="footer-social">
          <a href="#" class="social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div class="footer-col">
        <h3>Company</h3>
        <div class="footer-links">
          <a href="#hero">Home</a>
          <a href="#about">About Carol</a>
          <a href="#calculators">Estimators</a>
          <a href="#faq">Common Questions</a>
        </div>
      </div>

      <!-- Column 3: Services -->
      <div class="footer-col">
        <h3>Services</h3>
        <div class="footer-links">
          <a href="javascript:void(0)" class="service-modal-btn" data-service="purchase">Home Purchase</a>
          <a href="javascript:void(0)" class="service-modal-btn" data-service="renewal">Mortgage Renewal</a>
          <a href="javascript:void(0)" class="service-modal-btn" data-service="refinance">Equity & Refinance</a>
        </div>
      </div>

      <!-- Column 4: Location -->
      <div class="footer-col">
        <h3>Contact</h3>
        <div class="footer-links">
          <a href="tel:{{ site.phone }}">{{ site.phone }}</a>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          <p style="color: #cbd5e0; font-size: 0.9rem; margin-top: 10px;">{{ site.address }}</p>
        </div>
      </div>
    </div>

    <!-- Monumental Brand Row -->
    <div class="footer-brand-row">
      <span class="footer-brand-name">Carol Ann Bryant</span>
      <span class="footer-tagline">Licensed Mortgage Professional</span>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright" style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
        <p style="margin: 0;">&copy; {{ site.year or '2026' }} Carole Ann Bryant. All Rights Reserved.</p>
        <div style="display: flex; gap: 25px;">
          <a href="/privacy" class="footer-policy-link">Privacy Policy</a>
          <a href="/terms" class="footer-policy-link">Terms of Use</a>
        </div>
      </div>
      <p style="margin: 0;">{{ site.brokerage }} | Brokerage Licence #13119</p>
    </div>

    <div class="disclaimer">
      Dominion Lending Centres is a national mortgage brokerage and leasing company with more than 2,000 members offering free expert advice across Canada. {{ site.brokerage }} ({{ site.brokerageLicense }}). {{ site.license }}.
    </div>
  </div>
</footer>