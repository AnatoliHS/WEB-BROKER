<style>
  .footer {
    background-color: var(--primary-color);
    color: var(--white);
    padding: 80px 20px 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-col h3 {
    color: var(--white);
    font-size: 1.5rem;
    margin-bottom: 25px;
  }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
    color: #cbd5e0;
  }

  .footer-contact-item i {
    color: var(--accent-color);
    font-size: 1.2rem;
  }

  .footer-contact-item a:hover {
    color: var(--accent-color);
  }

  .footer-links a {
    display: block;
    margin-bottom: 12px;
    color: #cbd5e0;
  }

  .footer-links a:hover {
    color: var(--accent-color);
    padding-left: 5px;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 40px;
    text-align: center;
    font-size: 0.9rem;
    color: #a0aec0;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 20px;
    display: block;
  }

  .disclaimer {
    font-size: 0.8rem;
    line-height: 1.4;
    max-width: 900px;
    margin: 20px auto 0;
  }
</style>

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <span class="footer-logo">{{ site.name }}</span>
        <p style="color: #cbd5e0;">Professional mortgage solutions tailored to your unique financial situation. Access to hundreds of products and expert, unbiased advice.</p>
      </div>

      <div class="footer-col">
        <h3>Contact Information</h3>
        <div class="footer-contact-item">
          <i>📍</i>
          <span>{{ site.address }}</span>
        </div>
        <div class="footer-contact-item">
          <i>📞</i>
          <a href="tel:{{ site.phone }}">{{ site.phone }}</a>
        </div>
        <div class="footer-contact-item">
          <i>✉️</i>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
      </div>

      <div class="footer-col">
        <h3>Quick Links</h3>
        <div class="footer-links">
          <a href="#hero">Home</a>
          <a href="#about">About Carole</a>
          <a href="#services">Mortgage Services</a>
          <a href="#faq">FAQ</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ site.year or '2026' }} Carole Ann Bryant. All Rights Reserved.</p>
      <div class="disclaimer">
        Dominion Lending Centres is a national mortgage brokerage and leasing company with more than 2,000 members offering free expert advice across Canada. {{ site.brokerage }} ({{ site.brokerageLicense }}). {{ site.license }}.
      </div>
    </div>
  </div>
</footer>