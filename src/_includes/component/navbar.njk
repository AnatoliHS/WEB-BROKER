<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    transition: all 0.4s ease;
    background: transparent;
  }

  .navbar.scrolled {
    background: rgba(242, 248, 252, 0.95);
    backdrop-filter: blur(10px);
    padding: 15px 40px;
    box-shadow: var(--shadow);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: var(--font-serif);
    color: var(--primary-color);
  }

  .nav-portrait {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    flex-shrink: 0;
  }

  .nav-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .nav-name-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav-name {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
    transition: all 0.4s ease;
    color: var(--white); /* Initially white on desktop */
  }

  .nav-license {
    font-size: 0.75rem;
    font-weight: 500;
    margin-top: 2px;
    opacity: 1;
    max-height: 20px;
    transition: all 0.4s ease;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--white); /* Initially white on desktop */
  }

  /* Scrolled State Transitions */
  .navbar.scrolled .nav-portrait {
    width: 0;
    height: 80px;
    margin-right: -15px;
    opacity: 0;
    transform: scale(0);
  }

  .navbar.scrolled .nav-license {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
  }

  .navbar.scrolled .nav-name,
  .navbar.scrolled .nav-links a:not(.btn-primary) {
    color: var(--primary-color);
  }

  .nav-links {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-links a {
    font-family: 'Teodor', var(--font-serif);
    font-weight: 500;
    color: var(--white); /* Initially white on desktop */
    font-size: 1.1rem;
    position: relative;
    transition: all 0.4s ease;
  }

  .nav-links a.btn-primary {
    color: var(--white);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-color);
    transition: width 0.3s ease;
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .mobile-toggle {
    display: none;
    cursor: pointer;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    background-color: var(--white); /* Initially white */
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .navbar.scrolled .mobile-toggle span {
    background-color: var(--primary-color); /* Navy on scroll */
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 15px 20px;
    }

    .nav-portrait {
      width: 60px;
      height: 60px;
    }

    .navbar.scrolled .nav-portrait {
      height: 60px;
    }

    .nav-name {
      font-size: 1.15rem;
      color: var(--white); /* Changed to white as requested */
    }

    .nav-license {
      font-size: 0.7rem;
      color: var(--white); /* Changed to white as requested */
    }
    
    .nav-links a:not(.btn-primary) {
      color: var(--primary-color); /* Keep navy for the links inside the white drawer */
    }

    .mobile-toggle span {
      background-color: var(--white); /* Changed toggle bars to white */
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: var(--white);
      flex-direction: column;
      padding: 20px;
      gap: 20px;
      transform: translateY(-150%);
      transition: transform 0.4s ease;
      box-shadow: var(--shadow-lg);
    }

    .nav-links.open {
      transform: translateY(0);
    }

    .navbar.menu-open {
      background: var(--white) !important;
      box-shadow: var(--shadow-lg);
    }

    .navbar.menu-open .nav-name,
    .navbar.menu-open .nav-license {
      color: var(--primary-color) !important;
    }

    .navbar.menu-open .mobile-toggle span {
      background-color: var(--primary-color) !important;
    }

    /* Hamburger to X Animation */
    .navbar.menu-open .mobile-toggle span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .navbar.menu-open .mobile-toggle span:nth-child(2) {
      opacity: 0;
      transform: translateX(-10px);
    }

    .navbar.menu-open .mobile-toggle span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }

    .mobile-toggle {
      display: flex;
      z-index: 1001; /* Stay above dropdown drawer */
    }
  }
</style>

<nav class="navbar" id="navbar">
  <div class="nav-brand">
    <div class="nav-portrait">
      <img src="/assets/carol-ann-bryant.JPG" alt="Carole Ann Bryant">
    </div>
    <div class="nav-name-group">
      <div class="nav-name">{{ site.name }}</div>
      <div class="nav-license">Originator Licence #M08001276</div>
    </div>
  </div>

  <div class="nav-links" id="nav-links">
    <a href="#hero">Home</a>
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#calculators">Estimators</a>
    <a href="#reviews">Testimonials</a>
    <a href="#faq">FAQ</a>
    <a href="#contact" class="btn btn-primary">Get in Touch</a>
  </div>

  <div class="mobile-toggle" onclick="toggleMenu()">
    <span></span>
    <span></span>
    <span></span>
  </div>
</nav>

<script>
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });

  function toggleMenu() {
    const navbar = document.getElementById('navbar');
    const navLinks = document.getElementById('nav-links');
    navbar.classList.toggle('menu-open');
    navLinks.classList.toggle('open');
  }

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      
      const navbar = document.getElementById('navbar');
      const navLinks = document.getElementById('nav-links');
      
      navbar.classList.remove('menu-open');
      navLinks.classList.remove('open');
      
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth'
        });
      }
    });
  });
</script>